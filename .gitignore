# Go
/bin/
/dist/
*.exe
*.test
*.out
coverage.txt

# Node / frontend
node_modules/
frontend/dist/
build/bin/
# 控制台的构建结果，见 docs/architecture.md 第 5.10 节。仓库只保留占位文件，
# 构建后由 npm 脚本补回 .gitkeep，工作区保持干净
internal/console/dist/*
!internal/console/dist/.gitkeep

# Local data
.airlock/
*.db
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# 网页终端的构建结果，见 docs/architecture.md 第 5.11 节。构建后由 npm 脚本补回 .gitkeep
/internal/webterm/dist/*
!/internal/webterm/dist/.gitkeep
