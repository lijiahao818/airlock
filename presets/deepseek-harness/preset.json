{
  "id": "deepseek-harness",
  "name": "DeepSeek Harness",
  "provider": "deepseek",
  "ui": "web",
  "cmd": ["sh", "-c", "exec dsh web --no-open --host \"$(hostname -i)\" --port 3080 --trusted-host {webhost}"],
  "env": {
    "DEEPSEEK_BASE_URL": "{gate}/deepseek",
    "DEEPSEEK_API_KEY": "{placeholder}",
    "HTTPS_PROXY": "{gate}"
  },
  "web": {
    "port": 3080,
    "tokenPattern": "^dsh web: http://[^ ]+/\\?token=([A-Za-z0-9_-]{43})$",
    "openPath": "/?token={token}"
  }
}
