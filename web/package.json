{
  "name": "airlock-console",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build --outDir ../internal/console/dist --emptyOutDir && node -e \"const fs=require('fs');fs.closeSync(fs.openSync('../internal/console/dist/.gitkeep','a'))\"",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
